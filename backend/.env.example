# ─── FALKORDB CONFIGURATION ───────────────────────────────────────────────────
# Option 1: Local Docker (Default)
# Run: docker run -p 6379:6379 -p 3000:3000 -d falkordb/falkordb:latest
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
FALKORDB_SSL=false

# Option 2: FalkorDB Cloud (cloud.falkordb.com — Free Tier)
# FALKORDB_HOST=your-subdomain.falkordb.cloud
# FALKORDB_PORT=6379
# FALKORDB_PASSWORD=your_cloud_password
# FALKORDB_SSL=true

# ─── LLM PROVIDER ─────────────────────────────────────────────────────────────
# Fill in at least one for live LLM mode
GROQ_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Active provider: groq | openai
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# ─── APP SETTINGS ─────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
